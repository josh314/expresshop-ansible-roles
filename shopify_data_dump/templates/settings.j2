import * as path from 'node:path';

export const settings = {

  dumpPath: path.resolve('dump'),

  shopify: {
    store: '{{ shopify_credentials.store_name }}',
    apiKey: '{{ shopify_credentials.api_key }}',
    accessToken: '{{ shopify_credentials.access_token }}',
  },

  mongo: {
    host: '{{ db_host }}',
  {% if db_port is defined %}
    port: '{{ db_port }}',
  {% endif %}
    username: '{{ db_shopify_data_dump_user }}',
    password: '{{ db_shopify_data_dump_password }}',
    dbName: 'ehdb',
  {% if db_atlas is defined and db_atlas %}
    atlas: true,
  {% endif %}
  },

  sendgrid: {
    apiKey: '{{ shopify_data_dump__sendgrid_api_key }}'
  },

  contactEmail: '{{ shopify_data_dump__contact_email }}'

};